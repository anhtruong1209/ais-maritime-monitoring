# Supabase project URL and public anon (publishable) key.
# Safe to expose to the browser — access is governed by Row Level Security
# policies defined in supabase/migrations, not by secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: base URL of the future Python FastAPI AI prediction service.
# When unset, the app falls back to MockPredictionService (clearly labeled
# DEMO/MOCK data in the UI). Never expose this as NEXT_PUBLIC_*.
# AI_SERVICE_URL=http://localhost:8000
